{
  "name": "@ossl-dev/differens-narrate",
  "version": "0.1.1",
  "description": "Turns a differens edit script into sentences, markdown, JSON, or a token-frugal format for models",
  "keywords": [
    "diff",
    "semantic-diff",
    "narration",
    "llm",
    "code-review"
  ],
  "homepage": "https://github.com/ossl-dev/differens#readme",
  "bugs": {
    "url": "https://github.com/ossl-dev/differens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossl-dev/differens.git",
    "directory": "packages/narrate"
  },
  "license": "MIT",
  "author": "Mohammed Aman Khan",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external '@ossl-dev/*' --external 'tree-sitter*' && tsc --emitDeclarationOnly --declarationMap false && find dist -name '*.test.d.ts' -delete",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@ossl-dev/differens-core": "workspace:*"
  },
  "devDependencies": {
    "@ossl-dev/differens-tsconfig": "workspace:*"
  }
}
