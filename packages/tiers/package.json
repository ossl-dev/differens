{
  "name": "@ossl-dev/differens-tiers",
  "version": "0.1.1",
  "description": "Content-tier adapters that parse code, config and markup into trees the differens core can match",
  "keywords": [
    "diff",
    "ast",
    "tree-sitter",
    "parser",
    "semantic-diff",
    "yaml",
    "toml"
  ],
  "homepage": "https://github.com/ossl-dev/differens#readme",
  "bugs": {
    "url": "https://github.com/ossl-dev/differens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossl-dev/differens.git",
    "directory": "packages/tiers"
  },
  "license": "MIT",
  "author": "Mohammed Aman Khan",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external '@ossl-dev/*' --external 'tree-sitter*' && tsc --emitDeclarationOnly --declarationMap false && find dist -name '*.test.d.ts' -delete",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@ossl-dev/differens-core": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-lua": "^0.4.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@ossl-dev/differens-tsconfig": "workspace:*"
  }
}
