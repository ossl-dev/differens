{
  "name": "differens",
  "version": "0.2.0",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "bunx biome format --write .",
    "release": "bun scripts/publish.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:coverage-gate": "bun test --coverage --coverage-reporter=lcov && bun scripts/coverage-gate.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
