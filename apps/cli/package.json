{
  "name": "@ossl/differens-cli",
  "version": "0.1.0",
  "description": "Semantic diffing: what actually happened to your code, not which lines changed",
  "type": "module",
  "bin": {
    "differens": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --external tree-sitter --external 'tree-sitter-*' && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "clean": "rm -rf dist/"
  },
  "dependencies": {
    "@differens/core": "workspace:*",
    "@differens/correlate": "workspace:*",
    "@differens/git": "workspace:*",
    "@differens/narrate": "workspace:*",
    "@differens/tiers": "workspace:*",
    "tree-sitter": "^0.25.1",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@differens/tsconfig": "workspace:*"
  }
}
