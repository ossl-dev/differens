{
  "name": "differens",
  "version": "0.1.1",
  "author": "Mohammed Aman Khan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossl-dev/differens.git",
    "directory": "apps/cli"
  },
  "devDependencies": {
    "@ossl-dev/differens-core": "workspace:*",
    "@ossl-dev/differens-correlate": "workspace:*",
    "@ossl-dev/differens-git": "workspace:*",
    "@ossl-dev/differens-narrate": "workspace:*",
    "@ossl-dev/differens-tiers": "workspace:*",
    "@ossl-dev/differens-tsconfig": "workspace:*"
  },
  "bin": {
    "differens": "dist/index.js"
  },
  "bugs": {
    "url": "https://github.com/ossl-dev/differens/issues"
  },
  "description": "Semantic diffing: what actually happened to your code, not which lines changed",
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/ossl-dev/differens#readme",
  "keywords": [
    "diff",
    "semantic-diff",
    "ast",
    "ast-diff",
    "tree-sitter",
    "gumtree",
    "git",
    "difftool",
    "code-review",
    "llm",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external tree-sitter --external 'tree-sitter-*' && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "test": "bun test",
    "clean": "rm -rf dist/"
  },
  "type": "module"
}
